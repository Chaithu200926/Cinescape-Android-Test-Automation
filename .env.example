# Copy to .env and fill in. Never commit .env.

# The .apk to install before each test (the single .apk file, not an unzipped folder).
# Leave empty to test the copy already installed on the emulator or phone.
ANDROID_APK_PATH=C:\path\to\cinescape-uat.apk

# Internal UAT / Pre-UAT builds (npm run test:uat / test:pre-uat) are read from the newest .apk in
# <ANDROID_BUILDS_DIR>\Cinescape_Internal_UAT and \Cinescape_Internal_Pre_UAT. Set these only to pin one file.
# ANDROID_BUILDS_DIR=C:\softwares\KNCC testing
# ANDROID_UAT_APK_PATH=
# ANDROID_PRE_UAT_APK_PATH=

# Optional settings (defaults in src/android-config.ts):
# ANDROID_AVD=cinescape-pixel          # virtual phone to boot when no device is connected
# ANDROID_HEADLESS=1                   # run the emulator without its window
# ANDROID_KEEP_EMULATOR=1              # leave the emulator running after the tests (faster reruns)
# ANDROID_HOME=C:\Users\<you>\AppData\Local\Android\Sdk
# JAVA_HOME=C:\Users\<you>\AppData\Local\Java\jdk-17...
# FFMPEG_DIR=C:\Users\<you>\AppData\Local\ffmpeg\bin
# APPIUM_PORT=4723

# Optional test data. Android-prefixed values override the matching Test1 value;
# otherwise credentials are loaded from ../Test1/.env when that file is present.
# The kiosk project is also read for its wallet customer/code (not its fake KNET terminal).
# Never commit credentials or populate this example file with real values.
# ANDROID_TEST_USERNAME=
# ANDROID_TEST_PASSWORD=
# ANDROID_TEST_PIN=
# ANDROID_TEST2_USERNAME=
# ANDROID_TEST2_PASSWORD=
# ANDROID_TEST2_PIN=
# AND-02 generates a unique email and mobile by default, matching the Web UI signup test.
# Set these only to override individual generated test-user fields.
# Mobile number is entered with the form's +965 country code; date of birth uses YYYY-MM-DD.
# Gender must be male or female.
# ANDROID_TEST_NEW_USER_EMAIL=
# ANDROID_TEST_NEW_USER_FIRST_NAME=
# ANDROID_TEST_NEW_USER_LAST_NAME=
# ANDROID_TEST_NEW_USER_PASSWORD=
# ANDROID_TEST_NEW_USER_MOBILE=
# ANDROID_TEST_NEW_USER_DATE_OF_BIRTH=
# ANDROID_TEST_NEW_USER_GENDER=
# Email/mobile OTP for the new user (defaults to TEST_NEW_USER_OTP or UAT's 111111).
# ANDROID_TEST_NEW_USER_OTP=
# ANDROID_TEST_CARD_NUMBER=
# ANDROID_TEST_CARD_EXPIRY=
# ANDROID_TEST_CARD_CVV=
# ANDROID_TEST_KNET_NUMBER=
# ANDROID_TEST_KNET_EXPIRY=
# ANDROID_TEST_KNET_PIN=
# ANDROID_TEST_GIFT_CARD=
# ANDROID_TEST_WALLET_CODE=
