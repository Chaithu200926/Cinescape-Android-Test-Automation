# Copy to .env and fill in. Never commit .env.

# The .apk to install before each test (the single .apk file, not an unzipped folder).
# Leave empty to test the copy already installed on the emulator or phone.
ANDROID_APK_PATH=C:\path\to\cinescape-uat.apk

# Optional settings (defaults in src/android-config.ts):
# ANDROID_AVD=cinescape-pixel          # virtual phone to boot when no device is connected
# ANDROID_HEADLESS=1                   # run the emulator without its window
# ANDROID_KEEP_EMULATOR=1              # leave the emulator running after the tests (faster reruns)
# ANDROID_HOME=C:\Users\<you>\AppData\Local\Android\Sdk
# JAVA_HOME=C:\Users\<you>\AppData\Local\Java\jdk-17...
# FFMPEG_DIR=C:\Users\<you>\AppData\Local\ffmpeg\bin
# APPIUM_PORT=4723
